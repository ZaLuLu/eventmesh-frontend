# EventMesh Frontend Environment Configuration

# API Mode: 'mock' (standalone in-memory & localStorage simulation) or 'http' (real backend)
VITE_API_MODE=mock

# Base URL for the HTTP backend API (used when VITE_API_MODE=http)
VITE_API_BASE_URL=https://eventmesh-api.onrender.com

# Mock adapter settings
VITE_MOCK_LATENCY=400
VITE_MOCK_ERROR_RATE=0
